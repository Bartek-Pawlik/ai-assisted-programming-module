{
  "name": "AIAP Labs",
  // Python base rather than a lean single-language image, because this
  // module's labs are not one language: rag/mcp/agents/cicd are Python,
  // baas is a FastAPI backend WITH a React/TypeScript frontend, and
  // cli-agents installs terminal coding agents from npm, which need Node 22
  // or newer. One image covers every lab; per-lab devcontainers would
  // fragment the student's single copy.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "postCreateCommand": "python --version && node --version",
  // Refresh the lectures and lab instructions from the module repo each time
  // the workspace is opened. Content only -- it never touches your own code,
  // and it exits quietly (never non-zero) so it can't stop the Codespace
  // starting if you are offline. In the module's own repo it does nothing.
  "postAttachCommand": "bash scripts/update-course-content.sh --quiet || true"
}
