{
  "name": "AIAP Labs",
  // Python base rather than a lean single-language image, because the labs
  // are not one language: rag/mcp/agents/security/cicd are Python, and
  // cli-agents installs terminal coding agents from npm, which need Node 22
  // or newer. One image covers every lab; per-lab devcontainers would
  // fragment the student's single copy.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  // Each lab installs its own requirements (the README's first step), so
  // creating the container stays fast and a heavy lab such as rag does not
  // slow down every other week. pytest is the one thing every lab's tests
  // assume, so it is installed once here.
  "postCreateCommand": "python -m pip install --quiet --upgrade pip pytest && python --version && node --version",
  // Refresh the lectures and lab instructions from the module repo each time
  // the workspace is opened. Content only -- it never touches your own code,
  // and it exits quietly (never non-zero) so it can't stop the Codespace
  // starting if you are offline. In the module's own repo it does nothing.
  "postAttachCommand": "bash scripts/update-course-content.sh --quiet || true"
}
