+    """
+    parsed = urlparse(url)
+    hostname = parsed.netloc or parsed.path
+    parts = hostname.split('.')
     if len(parts) >= 3 and '.'.join(parts[-2:]) == 'co.uk':
         return '.'.join(parts[-3:])
     else:
         return '.'.join(parts[-2:])
